{
  "permissions": {
    "allow": [
      "mcp__factory",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(gh:*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "http",
            "url": "{{FORGE_URL}}/hooks/notification",
            "headers": {
              "x-forge-token": "{{FORGE_TOKEN}}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "{{FORGE_URL}}/hooks/session-end",
            "headers": {
              "x-forge-token": "{{FORGE_TOKEN}}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|Glob|Grep",
        "hooks": [
          {
            "type": "http",
            "url": "{{FORGE_URL}}/hooks/pre-tool-use",
            "headers": {
              "x-forge-token": "{{FORGE_TOKEN}}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "{{FORGE_URL}}/hooks/activity",
            "headers": {
              "x-forge-token": "{{FORGE_TOKEN}}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "{{FORGE_URL}}/hooks/activity",
            "headers": {
              "x-forge-token": "{{FORGE_TOKEN}}"
            },
            "timeout": 5
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
