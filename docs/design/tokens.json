{
  "$description": "Forge design tokens. Source of truth for code. Mirrors the 'Brand and UI' section of the project definition.",
  "name": "forge",
  "color": {
    "light": {
      "bg": "#FAFAF9",
      "surface": "#FFFFFF",
      "surface-2": "#F4F4F2",
      "border": "#E4E2DE",
      "text": "#1C1B19",
      "text-muted": "#5F5C57",
      "brand": "#C2410C",
      "brand-ink": "#FFFFFF",
      "brand-soft": "#FFF1EA",
      "spark": "#FDBA74",
      "terminal-bg": "#1C1B19",
      "terminal-text": "#E7E5E1",
      "terminal-muted": "#A8A49D",
      "terminal-tool": "#FDBA74"
    },
    "dark": {
      "bg": "#0F1011",
      "surface": "#17181A",
      "surface-2": "#1F2023",
      "border": "#2C2E32",
      "text": "#EDEDEC",
      "text-muted": "#A3A19C",
      "brand": "#F97316",
      "brand-ink": "#1A0B04",
      "brand-soft": "#2A1A10",
      "spark": "#FFF1EA",
      "terminal-bg": "#0B0C0D",
      "terminal-text": "#D9D7D2",
      "terminal-muted": "#8F8C86",
      "terminal-tool": "#FDBA74"
    }
  },
  "status": {
    "light": {
      "queued":          { "fg": "#5F5C57", "bg": "#EEEDEA" },
      "running":         { "fg": "#1D4ED8", "bg": "#E8EEFC" },
      "awaiting_review": { "fg": "#0F766E", "bg": "#E3F3F1" },
      "needs_attention": { "fg": "#6D28D9", "bg": "#F0EAFC" },
      "failed":          { "fg": "#B91C1C", "bg": "#FBE9E9" },
      "done":            { "fg": "#166534", "bg": "#E7F4EC" }
    },
    "dark": {
      "queued":          { "fg": "#A3A19C", "bg": "#232427" },
      "running":         { "fg": "#7AA7FF", "bg": "#16213A" },
      "awaiting_review": { "fg": "#2DD4BF", "bg": "#0F2A27" },
      "needs_attention": { "fg": "#B79CFF", "bg": "#221A38" },
      "failed":          { "fg": "#F87171", "bg": "#2E1616" },
      "done":            { "fg": "#4ADE80", "bg": "#122A1C" }
    }
  },
  "severity": {
    "light": { "critical": "#B91C1C", "high": "#B91C1C", "medium": "#B45309", "low": "#5F5C57" },
    "dark":  { "critical": "#F87171", "high": "#F87171", "medium": "#FBBF24", "low": "#A3A19C" }
  },
  "font": {
    "heading": { "family": "'Space Grotesk', sans-serif", "weight": 600, "letterSpacing": "-0.02em" },
    "body":    { "family": "Inter, system-ui, sans-serif", "weights": [400, 500, 600], "size": { "sm": "12px", "base": "14px", "lg": "16px" } },
    "mono":    { "family": "'JetBrains Mono', ui-monospace, monospace", "weights": [400, 500] },
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
  },
  "radius": { "sm": "8px", "md": "10px", "lg": "12px", "xl": "16px", "pill": "999px" },
  "size": { "control-height": "40px", "touch-target-min": "44px", "sidebar-width": "220px" },
  "rules": [
    "Text and badges meet 4.5:1 contrast in both themes.",
    "A state is never shown by color alone; badges always carry their label.",
    "Brand orange is never used for a pipeline state.",
    "The embedded terminal stays dark in both themes.",
    "Icons are inline stroke SVGs, never emoji."
  ]
}
